# Frontend environment template.
#
# Copy this file to `.env.local` (Vite's convention for local, gitignored
# overrides) and fill in values as needed. Vite inlines these at startup, so
# restart the dev server after any change.
#
# Everything below is OPTIONAL and only affects the "Hey Nota" wake word.
# Voice input via the mic button works without any of it.

# The wake word runs fully on-device via openWakeWord (no account or API key).
# It activates only when all three ONNX model files exist under public/oww/:
#
#   public/oww/melspectrogram.onnx   \  shared models, download from
#   public/oww/embedding_model.onnx  /  https://github.com/dscripka/openWakeWord/releases/tag/v0.5.1
#   public/oww/hey-nota.onnx         -  custom keyword model, trained with
#                                       openWakeWord's free Colab notebook
#                                       (linked from the repo README under
#                                       "Training New Models")
#
# Note: the pretrained openWakeWord models are licensed CC BY-NC-SA 4.0
# (non-commercial). The files are gitignored and stay out of the repo.

# Path the keyword model is served from. Defaults to /oww/hey-nota.onnx.
# Handy for testing with a stock pretrained keyword before training a custom
# one, e.g. the "hey jarvis" model from the same release page:
# VITE_WAKE_WORD_MODEL=/oww/hey_jarvis_v0.1.onnx
VITE_WAKE_WORD_MODEL=

# Detection threshold, a number between 0 and 1 (exclusive). Higher = fewer
# false wakes, lower = more sensitive. Defaults to 0.5.
VITE_WAKE_WORD_THRESHOLD=
