# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Anthropic API key used for command interpretation and tool orchestration.
# Required.
ANTHROPIC_API_KEY=

# OpenAI API key used for Whisper speech-to-text transcription.
# Required.
OPENAI_API_KEY=

# Secret key used to sign Flask session cookies. Use a long random string.
# Required.
SECRET_KEY=

# SQLAlchemy database URL. In production (APP_ENV=production) a SQLite URL
# must be an ABSOLUTE path on your mounted volume -- note the four slashes
# in sqlite:////data/nota.db -- or the app refuses to start, since a
# relative path would put the database inside the container and lose it on
# every deploy.
# Optional. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///nota.db

# Directory where uploaded/edited score files are stored on disk. Must be an
# absolute path in production, for the same reason as DATABASE_URL above.
# Optional. Defaults to ./data/scores relative to the backend working directory.
SCORE_STORAGE_DIR=./data/scores

# Maximum accepted upload size, in megabytes. Applies to PDF uploads too,
# where scanned multi-page scores can run large.
# Optional. Defaults to 25.
MAX_UPLOAD_MB=25

# Port the Flask dev server listens on.
# Optional. Defaults to 5001.
PORT=5001

# Claude model used by the command orchestrator.
# Optional. Defaults to claude-sonnet-4-6.
CLAUDE_MODEL=claude-sonnet-4-6

# Full path to the Audiveris launcher executable, used to convert uploaded
# PDFs to MusicXML. PDF import is disabled when unset.
# Optional. Example (Windows): C:\Users\you\tools\audiveris\Audiveris.exe
AUDIVERIS_PATH=

# How long Audiveris may run on one PDF before the conversion is abandoned,
# in seconds. Raise this for long, multi-page scores on slower machines.
# Optional. Defaults to 180.
OMR_TIMEOUT_S=180

# Number of parsed scores kept in the in-process read cache. Set to 0 to
# disable caching.
# Optional. Defaults to 4.
SCORE_CACHE_SIZE=4

# Set to 1 to bypass the indexed spanner lookup used to speed up MusicXML
# export, falling back to music21's stock implementation.
# Optional. Off (accelerator enabled) by default.
SPANNER_INDEX_DISABLE=

# Google OAuth client credentials for "Continue with Google" sign-in, from
# Google Cloud Console (APIs & Services -> Credentials -> OAuth client ID,
# type "Web application"). Google sign-in is disabled when either is unset.
# Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback URL registered with Google. In local dev this must be the
# frontend (Vite) origin, which proxies /api to Flask:
#   http://localhost:5173/api/auth/google/callback
# Leave unset in deployments where Flask itself is the public origin; the
# callback URL is then derived from the request.
# Optional.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Public origin of the frontend, used to build password-reset links. Falls
# back to the request's Origin/Referer header, then the request URL.
# Optional. Example (local dev): http://localhost:5173
APP_BASE_URL=

# SMTP server used to send password-reset emails. When SMTP_HOST is unset,
# reset links are logged to the backend console instead (dev mode).
# All optional. STARTTLS is used on port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nota.app

# Deployment environment. Set to "production" to enable Secure session
# cookies and disable the dev-only CORS handler.
# Optional. Defaults to development.
APP_ENV=

# Path to the built frontend bundle. When set, Flask serves the SPA itself
# (production single-container mode); leave unset in dev, where Vite
# serves the frontend.
# Optional. Example (Docker image): /app/frontend-dist
FRONTEND_DIST_DIR=

# Gunicorn tuning for the production entrypoint. Workers are pinned to 1
# in gunicorn.conf.py (correctness constraint); scale with threads.
# Optional.
GUNICORN_THREADS=16
GUNICORN_TIMEOUT=300

# Per-user daily usage limits (UTC days), protecting API spend. Commands
# call Claude; transcriptions call Whisper. Set a value of 0 or below to
# disable that limit.
# Optional. Defaults: 200 commands, 400 transcriptions.
DAILY_COMMAND_LIMIT=200
DAILY_TRANSCRIBE_LIMIT=400
