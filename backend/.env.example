# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Anthropic API key used for command interpretation and tool orchestration.
# Required.
ANTHROPIC_API_KEY=

# OpenAI API key used for Whisper speech-to-text transcription.
# Required.
OPENAI_API_KEY=

# Secret key used to sign Flask session cookies. Use a long random string.
# Required.
SECRET_KEY=

# SQLAlchemy database URL.
# Optional. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///nota.db

# Directory where uploaded/edited score files are stored on disk.
# Optional. Defaults to ./data/scores relative to the backend working directory.
SCORE_STORAGE_DIR=./data/scores

# Maximum accepted upload size, in megabytes. Applies to PDF uploads too,
# where scanned multi-page scores can run large.
# Optional. Defaults to 10.
MAX_UPLOAD_MB=10

# Port the Flask dev server listens on.
# Optional. Defaults to 5001.
PORT=5001

# Claude model used by the command orchestrator.
# Optional. Defaults to claude-sonnet-4-6.
CLAUDE_MODEL=claude-sonnet-4-6

# Full path to the Audiveris launcher executable, used to convert uploaded
# PDFs to MusicXML. PDF import is disabled when unset.
# Optional. Example (Windows): C:\Users\you\tools\audiveris\Audiveris.exe
AUDIVERIS_PATH=

# How long Audiveris may run on one PDF before the conversion is abandoned,
# in seconds. Raise this for long, multi-page scores on slower machines.
# Optional. Defaults to 180.
OMR_TIMEOUT_S=180

# Number of parsed scores kept in the in-process read cache. Set to 0 to
# disable caching.
# Optional. Defaults to 4.
SCORE_CACHE_SIZE=4

# Set to 1 to bypass the indexed spanner lookup used to speed up MusicXML
# export, falling back to music21's stock implementation.
# Optional. Off (accelerator enabled) by default.
SPANNER_INDEX_DISABLE=
